        },
        {
          "datasource": { "type": "prometheus", "uid": "AMP" },
          "expr": "rate(container_network_transmit_bytes_total{namespace=\"open5gs\", pod=~\"gnb.*\"}[2m])",
          "legendFormat": "gNB TX",
          "refId": "B"
        }
      ],
      "title": "gNB N3 Interface Throughput",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "AMP" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "custom": { "lineWidth": 2, "fillOpacity": 20 }, "unit": "Bps" }
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 8 },
