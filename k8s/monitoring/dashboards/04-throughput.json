        },
        {
          "datasource": { "type": "prometheus", "uid": "AMP" },
          "expr": "rate(container_network_receive_bytes_total{namespace=\"open5gs\", pod=~\"ue3.*\"}[2m])",
          "legendFormat": "UE3 URLLC (SST=3) RX",
          "refId": "C"
        }
      ],
      "title": "Per-Slice Downlink Throughput — eMBB / mMTC / URLLC",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "AMP" },
      "fieldConfig": {
