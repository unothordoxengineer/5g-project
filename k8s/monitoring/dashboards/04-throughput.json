  "description": "GTP-U and data-plane throughput across all network slices",
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "AMP" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "custom": { "lineWidth": 2 }, "unit": "Bps" }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "id": 1,
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "AMP" },
          "expr": "rate(container_network_receive_bytes_total{namespace=\"open5gs\", pod=~\"upf.*\"}[2m])",
          "legendFormat": "{{pod}} RX (GTP-U downlink)",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "AMP" },
          "expr": "rate(container_network_transmit_bytes_total{namespace=\"open5gs\", pod=~\"upf.*\"}[2m])",
          "legendFormat": "{{pod}} TX (GTP-U uplink)",
          "refId": "B"
        }
      ],
      "title": "UPF GTP-U Throughput",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "AMP" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "custom": { "lineWidth": 2 }, "unit": "Bps" }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "id": 2,
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "AMP" },
          "expr": "rate(container_network_receive_bytes_total{namespace=\"open5gs\", pod=~\"gnb.*\"}[2m])",
